# ==========================================
# Gateway Rota.IA (https://github.com/lucascabralds/Rota-ia)
# ==========================================
# Todas as chamadas de IA do projeto passam pelo endpoint local do Rota.IA,
# que decide por trás qual provedor cadastrado (Gemini, OpenAI, Claude, Groq,
# DeepSeek, etc.) atende — e troca sozinho se algum falhar.
# Rode o gateway com `npm run start` dentro da pasta rota-ia; a
# INTERNAL_API_KEY aparece no terminal e também na aba "Documentação da API".
ROTA_IA_URL=http://localhost:8787/v1
ROTA_IA_API_KEY=cole_aqui_sua_internal_api_key_do_rota_ia
ROTA_IA_MODEL=auto
# Limite de tamanho da resposta da IA (tokens). Baixo demais = JSON cortado no meio.
ROTA_IA_MAX_TOKENS=2048
# Se o gateway não responder, pausa as chamadas de IA por N segundos (usa heurística)
ROTA_IA_PAUSA_SEG=300
# Quantas execuções seguidas um e-mail espera a IA voltar antes de cair na heurística
MAX_TENTATIVAS_IA=3

# Limite diário de chamadas de IA por módulo (ao zerar, entra a heurística local)
GEMINI_BUDGET_VAGAS=40
GEMINI_BUDGET_GERAL=10
GEMINI_BUDGET_ALERTAS=10

# ==========================================
# Supabase (persistência)
# ==========================================
# Rode supabase/schema.sql no SQL Editor do Supabase antes da 1ª execução
# (ou de novo depois de atualizar o projeto — o script é idempotente).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=cole_sua_service_role_ou_anon_key

# ==========================================
# Google (Gmail / Drive / Tasks)
# ==========================================
# Opcional: caminhos alternativos do credentials.json e token.json
# GMAIL_CREDENTIALS_PATH=/caminho/credentials.json
# GMAIL_TOKEN_PATH=/caminho/token.json

# ID da pasta do Google Drive onde os certificados são salvos (opcional)
DRIVE_FOLDER_ID=

# Cria follow-ups "Candidatar: <cargo>" no Google Tasks para vagas de score alto.
# Ao ligar, o navegador abre uma vez para autorizar o escopo do Tasks.
GOOGLE_TASKS_ENABLED=false

# Vencimentos (boletos, IPVA, multas) e agendamentos viram eventos no Google
# Calendar, com lembrete. Ao ligar, o navegador abre uma vez para autorizar.
GOOGLE_CALENDAR_ENABLED=false
CALENDAR_ID=primary
LEMBRETE_DIAS_ANTES=2

# Máximo de e-mails lidos por módulo em cada execução
LIMITE_EMAILS_POR_MODULO=100

# ==========================================
# Notificações no Telegram (opcional)
# ==========================================
# 1. Crie um bot com o @BotFather e copie o token
# 2. Mande qualquer mensagem para o bot e abra
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver o chat id
# 3. Teste com: python notificador.py "olá"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Só notifica OTPs de e-mails com até N minutos (códigos velhos já expiraram)
OTP_MAX_IDADE_MIN=15
# Score mínimo para uma vaga virar notificação (e follow-up no Tasks)
SCORE_NOTIFICAR_VAGA=75
# Score de match (match_vagas.py): regras do perfil + score da IA, com o
# motivo de cada ponto. Presencial/híbrido nestas regiões ganha pontos; fora
# delas perde (remoto vale sempre). Separe por vírgula.
LOCAIS_ACEITOS=São Paulo,SP

# ==========================================
# Rascunhos de candidatura (candidatura.py)
# ==========================================
# Para vagas de score alto, a IA escreve uma carta baseada no seu perfil e
# cria um RASCUNHO no Gmail (nada é enviado sozinho).
RASCUNHOS_CANDIDATURA=false
SCORE_RASCUNHO=80
# Currículo anexado aos rascunhos (opcional)
CURRICULO_PDF=
# Perfil usado pela IA (seções marcadas como "uso interno" nunca são enviadas)
# PERFIL_PATH=services/perfil_profissional_lucas.md
GEMINI_BUDGET_CARTAS=5

# ==========================================
# Briefing diário
# ==========================================
# Destinatário do briefing — "me" = o próprio Gmail autenticado
BRIEFING_DESTINATARIO=me

# ==========================================
# Agendador / Docker (agendador.py)
# ==========================================
ALERTAS_INTERVALO_MIN=1
PIPELINE_INTERVALO_MIN=30
# Horário do briefing diário (HH:MM). Deixe vazio para desligar.
BRIEFING_HORARIO=07:30
# Em servidor/Docker: nunca abre o navegador para o OAuth
AUTOAPPLY_HEADLESS=false
# Endereço do Rota.IA visto de dentro do container
ROTA_IA_URL_DOCKER=http://host.docker.internal:8787/v1

# ==========================================
# Scripts legados em services/ (não usados pelo main.py)
# ==========================================
# GEMINI_API_KEY não é mais usada — as chaves de IA ficam no painel do Rota.IA.
# Certificado_Drive é lida apenas por services/gmail/extrator_certificados.py.
Certificado_Drive=caminho_absoluto_para_sua_pasta_aqui
