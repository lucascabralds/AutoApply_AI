# ==========================================
# Gateway Rota.IA (https://github.com/lucascabralds/Rota-ia)
# ==========================================
# Todas as chamadas de IA do projeto passam pelo endpoint local do Rota.IA,
# que decide por trás qual provedor cadastrado (Gemini, OpenAI, Claude, Groq,
# DeepSeek, etc.) atende — e troca sozinho se algum falhar.
# Rode o gateway com `npm run start` dentro da pasta rota-ia; a
# INTERNAL_API_KEY aparece no terminal e também na aba "Documentação da API".
ROTA_IA_URL=http://localhost:8787/v1
ROTA_IA_API_KEY=cole_aqui_sua_internal_api_key_do_rota_ia
ROTA_IA_MODEL=auto

# ==========================================
# Configurações do Google Gemini (legado)
# ==========================================
# Não é mais usada diretamente pelo projeto — as chaves de IA agora são
# cadastradas dentro do próprio painel do Rota.IA. Mantida aqui apenas caso
# algum script auxiliar ainda dependa dela.
# Gere sua chave no Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=cole_sua_chave_aqui_sem_aspas

# ==========================================
# Caminhos e Diretórios Locais
# ==========================================
# Caminho absoluto para a pasta onde os anexos e PDFs serão salvos
# Exemplo Windows: C:/Users/SeuUsuario/Documents/Certificados_AutoApply
# Exemplo Linux/Mac: /home/usuario/certificados_autoapply
Certificado_Drive=caminho_absoluto_para_sua_pasta_aqui